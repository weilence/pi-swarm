# Copy to .env for local Pi credentials/configuration as required by your Pi setup.
# Do not commit real credentials.
PI_SWARM_WORKER=mock
PI_SWARM_MODULE=user-service

# Set PI_SWARM_WORKER=pi to use the Pi SDK worker.
# Models.dev provider/model selection is available in the interactive CLI:
# /provider <provider-id> [anthropic|openai|responses|google|codex|azure|vertex|mistral|bedrock]
# /model <model-id>
# Provider credentials are read by Pi, for example:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
